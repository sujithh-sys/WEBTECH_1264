<!DOCTYPE html>
<html>
<head>

    <title>Health and Wellness Blog</title>

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, Helvetica, sans-serif;
        }

        body {
            background: #f4f4f4;
        }

        /* Header */
        header {
            background: linear-gradient(#1b5e20, #43a047);
            height: 180px;
            position: relative;
            color: white;
        }

        .logo {
            width: 80px;
            margin: 20px;
        }

        header h1 {
            position: absolute;
            top: 55px;
            left: 130px;
            font-size: 32px;
        }

        /* Navigation Bar */
        nav {
            background: #333;
        }

        nav ul {
            list-style: none;
            display: flex;
        }

        nav ul li {
            position: relative;
        }

        nav ul li a {
            color: white;
            text-decoration: none;
            display: block;
            padding: 15px 35px;
        }

        /* Hover Effect */
        nav ul li:hover {
            background: #2e7d32;
        }

        /* Dropdown Menu */
        .dropdown {
            display: none;
            position: absolute;
            background: #444;
            width: 180px;
            z-index: 10;
        }

        .dropdown li {
            width: 100%;
        }

        .dropdown li a {
            padding: 15px;
            color: white;
        }

        nav ul li:hover .dropdown {
            display: block;
        }

        .dropdown li:hover {
            background: #2e7d32;
        }

        /* Form Section */
        .container {
            background-image: url("https://images.unsplash.com/photo-1498837167922-ddd27525d352?auto=format&fit=crop&w=1500&q=80");
            background-size: cover;
            background-position: center;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 50px;
            padding: 80px;
        }

        /* Form Boxes */
        .box {
            background: white;
            width: 320px;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 0 15px rgba(0, 0, 0, 0.5);
        }

        .box h2 {
            text-align: center;
            margin-bottom: 20px;
            color: #222;
        }

        /* Labels */
        label {
            font-weight: bold;
            display: block;
            margin-bottom: 5px;
        }

        /* Input Fields */
        input[type=text],
        input[type=email],
        input[type=password] {
            width: 100%;
            padding: 12px;
            margin-top: 5px;
            margin-bottom: 18px;
            border: 1px solid #ccc;
            border-radius: 5px;
        }

        /* Submit Button */
        input[type=submit] {
            width: 100%;
            padding: 12px;
            border: none;
            background: #2e7d32;
            color: white;
            font-size: 16px;
            border-radius: 5px;
            cursor: pointer;
        }

        /* Button Hover */
        input[type=submit]:hover {
            background: #1b5e20;
        }

        /* Footer */
        footer {
            background: #c8e6c9;
            text-align: center;
            padding: 20px;
            font-size: 18px;
        }

    </style>

</head>

<body>

    <!-- Header -->
    <header>

        <img src="https://cdn-icons-png.flaticon.com/512/2966/2966486.png"
             class="logo"
             alt="Health Logo">

        <h1>Health and Wellness Blog</h1>

    </header>


    <!-- Navigation Bar -->
    <nav>

        <ul>

            <li>

                <a href="#">Home</a>

                <!-- Dropdown Menu -->
                <ul class="dropdown">

                    <li>
                        <a href="#">Healthy Living</a>
                    </li>

                    <li>
                        <a href="#">Fitness</a>
                    </li>

                    <li>
                        <a href="#">Nutrition</a>
                    </li>

                    <li>
                        <a href="#">Mental Wellness</a>
                    </li>

                </ul>

            </li>

            <li>
                <a href="#">Health Tips</a>
            </li>

            <li>
                <a href="#">Fitness</a>
            </li>

            <li>
                <a href="#">Nutrition</a>
            </li>

            <li>
                <a href="#">About</a>
            </li>

        </ul>

    </nav>


    <!-- Forms Section -->
    <section class="container">

        <!-- Sign In -->
        <div class="box">

            <h2>Sign In</h2>

            <form>

                <label>Username</label>

                <input type="text"
                       placeholder="Enter Username">

                <label>Password</label>

                <input type="password"
                       placeholder="Enter Password">

                <input type="submit"
                       value="Sign In">

            </form>

        </div>


        <!-- Sign Up -->
        <div class="box">

            <h2>Sign Up</h2>

            <form>

                <label>Name</label>

                <input type="text"
                       placeholder="Enter Name">

                <label>Email</label>

                <input type="email"
                       placeholder="Enter Email">

                <label>Password</label>

                <input type="password"
                       placeholder="Enter Password">

                <input type="submit"
                       value="Sign Up">

            </form>

        </div>

    </section>


    
    <footer>

        <p>Health and Wellness Blog</p>

        <p>
            © 2026-2027. URK24CS1264 -
            Web Technology Lab Batch 5.
            All Rights Reserved.
        </p>

    </footer>

</body>
</html>
