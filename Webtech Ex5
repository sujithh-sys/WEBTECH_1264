<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Health and Wellness Blog</title>

    <link rel="stylesheet" href="style.css">
</head>

<body>

    <!-- Header -->
    <header>
        <h1>🌿 Health and Wellness Blog</h1>
        <p>Simple Ideas for a Healthier Life</p>
    </header>

    <!-- Search and Filter -->
    <section class="controls">

        <input type="text" id="searchBox"
               placeholder="Search health tips...">

        <select id="filterRating">
            <option value="all">All Ratings</option>
            <option value="5">5 Stars</option>
            <option value="4">4 Stars</option>
            <option value="3">3 Stars</option>
            <option value="2">2 Stars</option>
            <option value="1">1 Star</option>
        </select>

        <button id="clearBtn">Clear All Posts</button>

    </section>

    <!-- Add Wellness Post -->
    <section class="form-section">

        <h2>Add a Wellness Post</h2>

        <fieldset>

            <label>
                Post Title:
                <input type="text" id="postTitle"
                       placeholder="Enter post title">
            </label>

            <label>
                Category:

                <select id="postCategory">
                    <option value="Nutrition">Nutrition</option>
                    <option value="Fitness">Fitness</option>
                    <option value="Mental Wellness">Mental Wellness</option>
                    <option value="Healthy Habits">Healthy Habits</option>
                    <option value="Sleep">Sleep</option>
                </select>
            </label>

            <label>
                Rating:

                <select id="postRating">
                    <option value="5">5 Stars</option>
                    <option value="4">4 Stars</option>
                    <option value="3">3 Stars</option>
                    <option value="2">2 Stars</option>
                    <option value="1">1 Star</option>
                </select>
            </label>

            <label>
                Your Health Tip:

                <textarea id="postText" rows="3"
                          placeholder="Write your health tip..."></textarea>
            </label>

            <button id="addBtn">Add Post</button>

            <span id="errorMsg" class="error"></span>

        </fieldset>

    </section>

    <!-- Blog Statistics -->
    <section class="stats">

        <h2>Blog Statistics</h2>

        <p>Total Posts: <span id="totalCount">0</span></p>

        <p>Average Rating:
            <span id="avgRating">0.0</span> ⭐
        </p>

        <p>Top Rated Post:
            <span id="topPost">—</span>
        </p>

    </section>

    <!-- Display Posts -->
    <section class="reviews-section">

        <h2>Health and Wellness Posts</h2>

        <div id="postContainer"></div>

        <p id="noResults" class="no-results"
           style="display:none;">
            No posts match your search.
        </p>

    </section>

    <!-- Footer -->
    <footer>
        <p>
            © 2026 Health and Wellness Blog |
            Web Technology Lab | URK24CS1264
        </p>
    </footer>

    <script src="script.js"></script>

</body>
</html>

