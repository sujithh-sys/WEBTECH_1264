<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Health & Wellness Blog</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f2f2f2;
            margin: 0;
        }

        header {
            background: #2e7d32;
            color: white;
            text-align: center;
            padding: 20px;
        }

        nav {
            background: #222;
            text-align: center;
            padding: 10px;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 15px;
        }

        section {
            width: 90%;
            margin: 20px auto;
            background: white;
            padding: 20px;
            border-radius: 10px;
        }

        img {
            width: 400px;
            display: block;
            margin: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        table,
        th,
        td {
            border: 1px solid black;
            padding: 10px;
            text-align: center;
        }

        footer {
            background: #2e7d32;
            color: white;
            text-align: center;
            padding: 15px;
        }

        progress {
            width: 300px;
            height: 20px;
        }
    </style>
</head>

<body>

    <header>
        <h1>Health & Wellness Blog</h1>
        <p>Your Guide to a Healthy Lifestyle</p>
    </header>

    <nav>
        <a href="#">Home</a>
        <a href="#">Nutrition</a>
        <a href="#">Fitness</a>
        <a href="#">Contact</a>
    </nav>

    <section>
        <h2>About Health & Wellness</h2>

        <img src="health img.png" alt="Health and Wellness">

        <p>
            Health and wellness focus on maintaining a healthy body and mind through
            proper nutrition, regular exercise, quality sleep, and stress management.
            A healthy lifestyle improves physical fitness, mental well-being, and
            overall quality of life.
        </p>
    </section>

    <section>
        <h2>Healthy Lifestyle Tips</h2>

        <table>
            <tr>
                <th>Category</th>
                <th>Benefit</th>
            </tr>

            <tr>
                <td>Healthy Diet</td>
                <td>Provides essential nutrients</td>
            </tr>

            <tr>
                <td>Regular Exercise</td>
                <td>Improves strength and fitness</td>
            </tr>

            <tr>
                <td>Mental Wellness</td>
                <td>Reduces stress and anxiety</td>
            </tr>
        </table>
    </section>

    <section>
        <h2>Health & Wellness Video</h2>

        <iframe width="560" height="315"
            src="Health and wellness video.mp4"
            title="Health and Wellness Video"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen>
        </iframe>
    </section>

    <section>
        <h2>Wellness Audio</h2>

        <audio controls>
            <source src="Health audio.mp3" type="audio/mpeg">
            Your browser does not support the audio tag.
        </audio>
    </section>

    <section>
        <h2>Health Guide PDF</h2>

        <embed src="health and wellness pdf.pdf" type="application/pdf" width="600" height="500">
    </section>

    <section>
        <h2>Health Progress</h2>

        <label>Healthy Diet</label><br>
        <progress value="90" max="100"></progress>

        <br><br>

        <label>Daily Exercise</label><br>
        <progress value="80" max="100"></progress>
    </section>

    <section>
        <h2>Health Registration Form</h2>

        <form>
            <fieldset>
                <legend>Join Our Wellness Community</legend>

                <label>Name</label><br>
                <input type="text"><br><br>

                <label>Email</label><br>
                <input type="email"><br><br>

                <label>Favourite Activity</label><br>
                <select>
                    <option>Healthy Eating</option>
                    <option>Yoga</option>
                    <option>Gym Workout</option>
                    <option>Walking</option>
                </select>

                <br><br>

                <label>Comments</label><br>
                <textarea rows="5" cols="40"></textarea>

                <br><br>

                <input type="submit" value="Submit">
            </fieldset>
        </form>
    </section>

    <footer>
        <p>&copy; 2026 Health & Wellness Blog</p>
    </footer>

</body>
</html>
